{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api",
      "dest": "/api/index.py?route=health"
    },
    {
      "src": "/api/health",
      "dest": "/api/index.py?route=health"
    },
    {
      "src": "/api/models",
      "dest": "/api/index.py?route=models"
    },
    {
      "src": "/api/analyze",
      "dest": "/api/index.py?route=analyze"
    },
    {
      "src": "/api/batch-analyze",
      "dest": "/api/index.py?route=analyze"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py?route=not-found"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
